<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} | Simple Quiz</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="app-shell">
  <header class="site-header border-bottom bg-white">
    <nav class="navbar navbar-expand-lg navbar-light">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/quizzes">
          <span class="brand-mark" aria-hidden="true">Q</span>
          <span><strong>Simple Quiz</strong><small>Question management</small></span>
        </a>
        <div class="navbar-nav ms-auto">
          <a class="nav-link nav-pill" href="/quizzes">Quizzes</a>
          <a class="nav-link nav-pill" href="/questions">Questions</a>
        </div>
      </div>
    </nav>
  </header>
  <main class="container py-4 py-lg-5"><div id="flash-region" class="flash-region" aria-live="polite"></div>{{{body}}}</main>
  <footer class="site-footer">
    <div class="container text-center">
      <span class="footer-muted">&copy; 2026 Simple Quiz. Bản quyền được bảo lưu.</span>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/javascripts/app.js"></script>
