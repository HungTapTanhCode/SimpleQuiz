<%- include('../partials/header.hbs') %>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><p class="eyebrow mb-1">Question details</p><h1 class="h2 mb-0"><%= question.text %></h1></div><div class="d-flex gap-2"><% if (currentUser && question.author && String(question.author) === String(currentUser.id)) { %><a class="btn btn-primary" href="/questions/<%= question._id %>/edit">Edit Question</a><% } %><a class="btn btn-light" href="/questions">Back</a></div></div>
<section class="bg-white border rounded-3 p-4"><h2 class="h5 mb-3">Answer options</h2><ol class="list-group list-group-numbered mb-4"><% (question.options || []).forEach((option, index) => { %><li class="list-group-item d-flex justify-content-between align-items-center"><span><%= option %></span><% if (index === question.correctAnswerIndex) { %><span class="badge text-bg-success">Correct</span><% } %></li><% }) %></ol><% if (question.keywords && question.keywords.length) { %><p class="small text-secondary mb-0"><strong>Keywords:</strong> <%= question.keywords.join(', ') %></p><% } %></section>
<%- include('../partials/footer.hbs') %>
