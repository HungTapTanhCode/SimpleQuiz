<%- include('../partials/header.hbs') %>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div><p class="eyebrow mb-1">Question bank</p><h1 class="h2 mb-1">Questions</h1><p class="text-secondary mb-0">Maintain reusable questions for every quiz.</p></div>
  <% if (currentUser) { %><a class="btn btn-primary" href="/questions/new">Create New Question</a><% } %>
</div>
<% if (!questions.length) { %>
  <div class="empty-state bg-white border rounded-3 p-5 text-center"><h2 class="h5">No questions yet</h2><p class="text-secondary mb-3">Add a question to make it available in your quizzes.</p><% if (currentUser) { %><a class="btn btn-outline-primary" href="/questions/new">Create New Question</a><% } else { %><a class="btn btn-outline-primary" href="/login">Sign in to create</a><% } %></div>
<% } else { %>
  <div class="table-responsive bg-white border rounded-3"><table class="table align-middle mb-0"><thead><tr><th>Question</th><th>Options</th><th class="text-end">Actions</th></tr></thead><tbody>
  <% questions.forEach(question => { const isAuthor = currentUser && question.author && String(question.author) === String(currentUser.id); %><tr><td><a class="link-dark fw-semibold" href="/questions/<%= question._id %>"><%= question.text %></a><% if (question.keywords && question.keywords.length) { %><div class="small text-secondary"><%= question.keywords.join(', ') %></div><% } %></td><td><span class="badge text-bg-light border"><%= (question.options || []).length %> options</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" href="/questions/<%= question._id %>">View</a> <% if (isAuthor) { %><a class="btn btn-sm btn-outline-primary" href="/questions/<%= question._id %>/edit">Edit</a> <form class="d-inline" method="post" action="/questions/<%= question._id %>" data-confirm="Delete this question? It will also be removed from quizzes."><input type="hidden" name="_method" value="DELETE"><button class="btn btn-sm btn-outline-danger" type="submit" data-loading-text="Deleting...">Delete</button></form><% } %></td></tr><% }) %>
  </tbody></table></div>
<% } %>
<%- include('../partials/footer.hbs') %>
