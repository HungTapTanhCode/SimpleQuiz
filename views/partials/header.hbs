<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
<title>Simple Quiz123</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="app-shell">
<header class="site-header border-bottom bg-white">
  <nav class="navbar navbar-expand-lg navbar-light">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/quizzes">
        <span class="brand-mark" aria-hidden="true">Q</span>
        <span><strong>Simple Quiz</strong><small>Question management</small></span>
      </a>
      <div class="navbar-nav ms-auto align-items-center">
        <a class="nav-link nav-pill" href="/quizzes">Quizzes</a>
        <a class="nav-link nav-pill" href="/questions">Questions</a>
        <% if (currentUser) { %>
          <% if (currentUser.admin) { %><a class="nav-link nav-pill" href="/admin/users">Users</a><% } %>
          <span class="user-chip ms-2"><span class="user-dot"></span><%= currentUser.username %><small><%= currentUser.admin ? 'Admin' : 'Author' %></small></span>
          <form method="post" action="/logout" class="ms-2"><button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button></form>
        <% } else { %>
          <a class="btn btn-sm btn-outline-secondary ms-2" href="/login">Sign in</a>
          <a class="btn btn-sm btn-primary ms-2" href="/register">Create account</a>
        <% } %>
      </div>
    </div>
  </nav>
</header>
<main class="container py-4 py-lg-5">
<div id="flash-region" class="flash-region" aria-live="polite"></div>
